{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "අභිධම්ම මාතිකා",
  "version": "1.0.2",
  "identifier": "app.matika.desktop",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "අභිධම්ම මාතිකා",
        "width": 1200,
        "height": 850,
        "minWidth": 420,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Dhamma Study Apps",
    "copyright": "අභිධර්ම මාතිකා අධ්‍යයනය — matika-snowy.vercel.app",
    "category": "Education",
    "shortDescription": "අභිධර්ම මාතිකා අධ්‍යයනය — Tika Matika App",
    "longDescription": "Abhidhamma Matika study app: tika, duka, suttanta and sabbattika matika with paramattha reference. Works offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      }
    }
  },
  "mainBinaryName": "abhidhamma-matika"
}
